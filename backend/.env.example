# Create a new one with CLEARLY fake placeholders
(
echo # ========================================
echo # Multi-Agent AI Assistant Configuration
echo # ========================================
echo.
echo # Copy this to .env and fill in your values
echo.
echo # API Keys
echo OPENAI_API_KEY=your-openai-key-here
echo ANTHROPIC_API_KEY=your-anthropic-key-here
echo.
echo # LLM Configuration
echo DEFAULT_LLM_MODEL=gpt-4o
echo DEFAULT_TEMPERATURE=0.7
echo MAX_TOKENS=4000
echo.
echo # Application
echo APP_NAME=Multi-Agent AI Assistant
echo DEBUG=True
echo API_VERSION=v1
echo.
echo # CORS Origins
echo CORS_ORIGINS=http://localhost:3000,http://localhost:3001
echo.
echo # File Upload
echo UPLOAD_DIR=data/uploads
echo MAX_UPLOAD_SIZE=10485760
echo.
echo # Vector Store
echo VECTOR_STORE_DIR=data/vector_db
echo EMBEDDING_MODEL=text-embedding-3-small
echo CHUNK_SIZE=1000
echo CHUNK_OVERLAP=200
echo.
echo # Agent Configuration
echo MAX_ITERATIONS=10
echo AGENT_TIMEOUT=300
echo.
echo # Redis
echo REDIS_HOST=localhost
echo REDIS_PORT=6379
echo REDIS_DB=0
) > .env.example